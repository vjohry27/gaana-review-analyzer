{
  "name": "gaana-review-analyzer",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "stop": "node scripts/stop-dev.js",
    "dev": "node scripts/stop-dev.js && concurrently -n api,vite -c blue,green \"npm run dev:api\" \"npm run dev:client:wait\"",
    "dev:client": "vite",
    "dev:client:wait": "node scripts/wait-for-api.js && vite",
    "dev:api": "node server/dev-server.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:scrape": "node scripts/test-scrape.js",
    "test:scrape:full": "node scripts/test-scrape.js --full",
    "verify:apple": "node scripts/verify-apple-sources.js"
  },
  "dependencies": {
    "app-store-scraper": "^0.18.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "google-play-scraper": "^10.0.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "vite": "^5.0.8"
  }
}
